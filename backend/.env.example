# Server Environment Configuration
NODE_ENV=development
APP_ENV=development
ALLOW_TEST_AUTH=false
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (Local MongoDB or MongoDB Atlas URI)
# Staging DB: mongodb+srv://<user>:<password>@cluster0.mongodb.net/lehulu-staging?retryWrites=true&w=majority
# Production DB: mongodb+srv://<user>:<password>@cluster0.mongodb.net/lehulu-production?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lehulu

# Security & Session Secrets (Must be at least 32 characters in production)
SESSION_SECRET=lehulu_super_secure_session_secret_change_in_production
JWT_SECRET=lehulu_jwt_signing_secret_change_in_production
COOKIE_DOMAIN=localhost

# Google Identity Services OAuth Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Super Administrator Auto-Provisioning Email
ADMIN_EMAIL=petrossisay1646@gmail.com

# File & Image Storage Configuration (local or cloud storage)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
